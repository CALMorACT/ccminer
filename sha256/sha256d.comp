#version 450
#extension GL_EXT_buffer_reference:require
#extension GL_EXT_scalar_block_layout:require
#extension GL_EXT_shader_explicit_arithmetic_types_int64:require

// Enable atomic operation extension
#extension GL_KHR_memory_scope_semantics:enable
#define IS_MINER_CALL
#define IS_MINER_RES


// SHA256d Vulkan Compute Shader
// Ported from CUDA cuda_sha256d.cu

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#ifdef IS_MINER_CALL
layout(buffer_reference, scalar) buffer ResultBuffer
{
    uint resNonces[2];
    uint totalFound;
#ifdef IS_MINER_RES
    uint totalThreads;
#endif
};
#else
layout(std430, binding = 3) buffer ResultBuffer
{
    uint resNonces[2];
    uint totalFound;
};
#endif


// Utility functions
uint ROTR(uint x, uint n)
{
    return (x >> n) | (x << (32 - n));
}

uint swab32(uint v)
{
    return ((v & 0xFF) << 24) | ((v & 0xFF00) << 8) |
    ((v & 0xFF0000) >> 8) | ((v & 0xFF000000) >> 24);
}

// Helper functions matching CUDA
void sha2_step1_inline(inout uint a, inout uint b, inout uint c, inout uint d,
inout uint e, inout uint f, inout uint g, inout uint h,
uint in_val, uint Kval)
{
    uint vxandx = ((f ^ g) & e) ^ g;
    uint bsg21 = ROTR(e, 6) ^ ROTR(e, 11) ^ ROTR(e, 25);
    uint bsg20 = ROTR(a, 2) ^ ROTR(a, 13) ^ ROTR(a, 22);
    uint andorv = (b & c) | ((b | c) & a);
    
    uint t1 = h + bsg21 + vxandx + Kval + in_val;
    uint t2 = bsg20 + andorv;
    d += t1;
    h = t1 + t2;
}

void sha2_step2_inline(inout uint a, inout uint b, inout uint c, inout uint d,
inout uint e, inout uint f, inout uint g, inout uint h,
inout uint dat[16], uint pc, uint Kval)
{
    int pcidx1 = int(pc - 2) & 15;
    int pcidx2 = int(pc - 7) & 15;
    int pcidx3 = int(pc - 15) & 15;
    
    uint inx0 = dat[pc];
    uint inx1 = dat[pcidx1];
    uint inx2 = dat[pcidx2];
    uint inx3 = dat[pcidx3];
    
    uint ssg21 = ROTR(inx1, 17) ^ ROTR(inx1, 19) ^(inx1 >> 10);
    uint ssg20 = ROTR(inx3, 7) ^ ROTR(inx3, 18) ^(inx3 >> 3);
    uint vxandx = ((f ^ g) & e) ^ g;
    uint bsg21 = ROTR(e, 6) ^ ROTR(e, 11) ^ ROTR(e, 25);
    uint bsg20 = ROTR(a, 2) ^ ROTR(a, 13) ^ ROTR(a, 22);
    uint andorv = (b & c) | ((b | c) & a);
    
    dat[pc] = ssg21 + inx2 + ssg20 + inx0;
    
    uint t1 = h + bsg21 + vxandx + Kval + dat[pc];
    uint t2 = bsg20 + andorv;
    d += t1;
    h = t1 + t2;
}

// SHA256 round functions - exact CUDA match
void sha256_round_body(inout uint dat[16], inout uint buf[8], uint K_arr[64])
{
    uint a = buf[0], b = buf[1], c = buf[2], d = buf[3];
    uint e = buf[4], f = buf[5], g = buf[6], h = buf[7];
    
    // First 16 rounds - manually unrolled with parameter rotation
    sha2_step1_inline(a, b, c, d, e, f, g, h, dat[ 0], K_arr[ 0]);
    // uint high32 = swab32(buf[7]);  // highest 32 bits of hash (after endianness conversion)
    // uint low32 = swab32(buf[6]);   // second highest 32 bits of hash (after endianness conversion)
    // uint thread = gl_GlobalInvocationID.x +
    //                         gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x +
    //                         gl_GlobalInvocationID.z * gl_NumWorkGroups.x * gl_NumWorkGroups.y * gl_WorkGroupSize.x;
    // if(thread == 0x100) {
    //     // For testing: write the computed hash of nonce 0x02de749f
    //     // to resNonces
    //     uint64_t resultAddr = 0xb240000UL; // Placeholder address
    //     ResultBuffer resultBuf = ResultBuffer(resultAddr);
    //     resultBuf.resNonces[0] = high32;
    //     resultBuf.resNonces[1] = low32;
    //     resultBuf.totalFound = dat[3];
    //     // resNonces[0] = high32;
    //     // resNonces[1] = low32;
    //     // totalFound = dat[3];
    // }
    sha2_step1_inline(h, a, b, c, d, e, f, g, dat[ 1], K_arr[ 1]);
    sha2_step1_inline(g, h, a, b, c, d, e, f, dat[ 2], K_arr[ 2]);
    sha2_step1_inline(f, g, h, a, b, c, d, e, dat[ 3], K_arr[ 3]);
    sha2_step1_inline(e, f, g, h, a, b, c, d, dat[ 4], K_arr[ 4]);
    sha2_step1_inline(d, e, f, g, h, a, b, c, dat[ 5], K_arr[ 5]);
    sha2_step1_inline(c, d, e, f, g, h, a, b, dat[ 6], K_arr[ 6]);
    sha2_step1_inline(b, c, d, e, f, g, h, a, dat[ 7], K_arr[ 7]);
    sha2_step1_inline(a, b, c, d, e, f, g, h, dat[ 8], K_arr[ 8]);
    sha2_step1_inline(h, a, b, c, d, e, f, g, dat[ 9], K_arr[ 9]);
    sha2_step1_inline(g, h, a, b, c, d, e, f, dat[10], K_arr[10]);
    sha2_step1_inline(f, g, h, a, b, c, d, e, dat[11], K_arr[11]);
    sha2_step1_inline(e, f, g, h, a, b, c, d, dat[12], K_arr[12]);
    sha2_step1_inline(d, e, f, g, h, a, b, c, dat[13], K_arr[13]);
    sha2_step1_inline(c, d, e, f, g, h, a, b, dat[14], K_arr[14]);
    sha2_step1_inline(b, c, d, e, f, g, h, a, dat[15], K_arr[15]);
    
    // Rounds 16-63 (3 loops of 16)
    // Unrolled loop 0 (i=0)
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 0, K_arr[16]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 1, K_arr[17]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 2, K_arr[18]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 3, K_arr[19]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 4, K_arr[20]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 5, K_arr[21]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 6, K_arr[22]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 7, K_arr[23]);
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 8, K_arr[24]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 9, K_arr[25]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 10, K_arr[26]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 11, K_arr[27]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 12, K_arr[28]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 13, K_arr[29]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 14, K_arr[30]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 15, K_arr[31]);

    // Unrolled loop 1 (i=1)
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 0, K_arr[32]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 1, K_arr[33]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 2, K_arr[34]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 3, K_arr[35]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 4, K_arr[36]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 5, K_arr[37]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 6, K_arr[38]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 7, K_arr[39]);
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 8, K_arr[40]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 9, K_arr[41]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 10, K_arr[42]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 11, K_arr[43]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 12, K_arr[44]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 13, K_arr[45]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 14, K_arr[46]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 15, K_arr[47]);

    // Unrolled loop 2 (i=2)
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 0, K_arr[48]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 1, K_arr[49]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 2, K_arr[50]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 3, K_arr[51]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 4, K_arr[52]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 5, K_arr[53]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 6, K_arr[54]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 7, K_arr[55]);
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 8, K_arr[56]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 9, K_arr[57]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 10, K_arr[58]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 11, K_arr[59]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 12, K_arr[60]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 13, K_arr[61]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 14, K_arr[62]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 15, K_arr[63]);
    
    buf[0] += a; buf[1] += b; buf[2] += c; buf[3] += d;
    buf[4] += e; buf[5] += f; buf[6] += g; buf[7] += h;
}

void sha256_round_last(inout uint dat[16], inout uint buf[8], uint K_arr[64])
{
    uint a = buf[0], b = buf[1], c = buf[2], d = buf[3];
    uint e = buf[4], f = buf[5], g = buf[6], h = buf[7];
    
    // First 16 rounds
    sha2_step1_inline(a, b, c, d, e, f, g, h, dat[ 0], K_arr[ 0]);
    sha2_step1_inline(h, a, b, c, d, e, f, g, dat[ 1], K_arr[ 1]);
    sha2_step1_inline(g, h, a, b, c, d, e, f, dat[ 2], K_arr[ 2]);
    sha2_step1_inline(f, g, h, a, b, c, d, e, dat[ 3], K_arr[ 3]);
    sha2_step1_inline(e, f, g, h, a, b, c, d, dat[ 4], K_arr[ 4]);
    sha2_step1_inline(d, e, f, g, h, a, b, c, dat[ 5], K_arr[ 5]);
    sha2_step1_inline(c, d, e, f, g, h, a, b, dat[ 6], K_arr[ 6]);
    sha2_step1_inline(b, c, d, e, f, g, h, a, dat[ 7], K_arr[ 7]);
    sha2_step1_inline(a, b, c, d, e, f, g, h, dat[ 8], K_arr[ 8]);
    sha2_step1_inline(h, a, b, c, d, e, f, g, dat[ 9], K_arr[ 9]);
    sha2_step1_inline(g, h, a, b, c, d, e, f, dat[10], K_arr[10]);
    sha2_step1_inline(f, g, h, a, b, c, d, e, dat[11], K_arr[11]);
    sha2_step1_inline(e, f, g, h, a, b, c, d, dat[12], K_arr[12]);
    sha2_step1_inline(d, e, f, g, h, a, b, c, dat[13], K_arr[13]);
    sha2_step1_inline(c, d, e, f, g, h, a, b, dat[14], K_arr[14]);
    sha2_step1_inline(b, c, d, e, f, g, h, a, dat[15], K_arr[15]);
    
    // Rounds 16-47 (2 loops of 16)
    // Unrolled loop 0 (i=0)
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 0, K_arr[16]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 1, K_arr[17]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 2, K_arr[18]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 3, K_arr[19]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 4, K_arr[20]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 5, K_arr[21]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 6, K_arr[22]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 7, K_arr[23]);
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 8, K_arr[24]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 9, K_arr[25]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 10, K_arr[26]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 11, K_arr[27]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 12, K_arr[28]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 13, K_arr[29]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 14, K_arr[30]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 15, K_arr[31]);

    // Unrolled loop 1 (i=1)
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 0, K_arr[32]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 1, K_arr[33]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 2, K_arr[34]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 3, K_arr[35]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 4, K_arr[36]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 5, K_arr[37]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 6, K_arr[38]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 7, K_arr[39]);
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 8, K_arr[40]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 9, K_arr[41]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 10, K_arr[42]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 11, K_arr[43]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 12, K_arr[44]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 13, K_arr[45]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 14, K_arr[46]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 15, K_arr[47]);
    
    // Rounds 48-61 (14 rounds) - CUDA only does 14, not 16!
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 0, K_arr[48]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 1, K_arr[49]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 2, K_arr[50]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 3, K_arr[51]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 4, K_arr[52]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 5, K_arr[53]);
    sha2_step2_inline(c, d, e, f, g, h, a, b, dat, 6, K_arr[54]);
    sha2_step2_inline(b, c, d, e, f, g, h, a, dat, 7, K_arr[55]);
    sha2_step2_inline(a, b, c, d, e, f, g, h, dat, 8, K_arr[56]);
    sha2_step2_inline(h, a, b, c, d, e, f, g, dat, 9, K_arr[57]);
    sha2_step2_inline(g, h, a, b, c, d, e, f, dat, 10, K_arr[58]);
    sha2_step2_inline(f, g, h, a, b, c, d, e, dat, 11, K_arr[59]);
    sha2_step2_inline(e, f, g, h, a, b, c, d, dat, 12, K_arr[60]);
    sha2_step2_inline(d, e, f, g, h, a, b, c, dat, 13, K_arr[61]);
    
    // Only update buf[6] and buf[7]
    buf[6] += g;
    buf[7] += h;
}

void main()
{
    // const uint startNonce = 0;
    // Good Nonce: 0x02de759F
    const uint startNonce = 0x02de754F;
    const uint threadsSum = 1 << 28;

    const uint MidState[8] = uint[](
        0xde5c4195, 0xc21e7e70, 0xe6a365c2, 0x77f6bc03, 0xf651e23a, 0x6fb9b88a, 0x1decb688, 0xd6fddf1f
    );
    const uint DataEnd[4] = uint[](
        0x00000000, 0x00000000, 0x1d00ffff, 0x00000000
    );
    const uvec2 Target = uvec2(0xffffffff, 0x000000ff);

    // SHA256 constants (K table)
    const uint K[64] = uint[](
        0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
        0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3, 0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
        0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
        0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
        0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13, 0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
        0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
        0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
        0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208, 0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
    );

    // H256 initial values
    const uint H256[8] = uint[](
        0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
        0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
    );

    // uint thread = gl_GlobalInvocationID.x +
    //                 gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x +
    //                 gl_GlobalInvocationID.z * gl_NumWorkGroups.x * gl_WorkGroupSize.x * gl_NumWorkGroups.y * gl_WorkGroupSize.y;
    
    // Dispatch(5, 4, 65535), LocalSize(1, 1, 1)
    uint thread = gl_WorkGroupID.x +
    gl_WorkGroupID.y * 5 +
    gl_WorkGroupID.z * 5 * 4;
    if (thread >= threadsSum) return;
    #ifndef IS_MINER_CALL
    if(thread < 20) return;
#endif
    uint nonce = startNonce + thread;
    
    // Prepare first SHA256 input
    // Note: c_dataEnd80 is already byte-swapped
    // nonce does not need to be swapped again (CUDA version also does not swap)
    uint dat[16];
    for (int i = 0; i < 3; i++) dat[i] = DataEnd[i];
    dat[3] = nonce;  // use nonce directly, no byte swap
    dat[4] = 0x80000000;
    for (int i = 5; i < 15; i++) dat[i] = 0;
    dat[15] = 0x280;
    
    // First SHA256 (using midstate)
    uint buf[8];
    for (int i = 0; i < 8; i++) buf[i] = MidState[i];
    sha256_round_body(dat, buf, K);

    // Second SHA256
    for (int i = 0; i < 8; i++) dat[i] = buf[i];
    dat[8] = 0x80000000;
    for (int i = 9; i < 15; i++) dat[i] = 0;
    dat[15] = 0x100;
    
    for (int i = 0; i < 8; i++) buf[i] = H256[i];
    sha256_round_last(dat, buf, K);
    
    // Check if hash meets target
    // CUDA code analysis:
    //   uint64_t high = cuda_swab32ll(((uint64_t*)buf)[3]);
    //   if (high <= d_target[0])
    //
    // cuda_swab32ll does:
    //   convert buf[6]|buf[7]<<32 to swab32(buf[7])|swab32(buf[6])<<32
    //
    // This means the comparison is on the byte-swapped hash value
    // buf[] is little-endian, needs to be swapped to big-endian before comparison
    //
    // Correct implementation:
    uint high32 = swab32(buf[7]);  // highest 32 bits of hash (after byte swap)
    uint low32 = swab32(buf[6]);   // second highest 32 bits of hash (after byte swap)
    
    // target also needs to consider byte order
    // d_target is a 64-bit value copied from &ptarget[6]
    // ptarget[6] and ptarget[7] are already target values (big-endian)
    // so should be compared directly with swapped hash

    #ifdef IS_MINER_CALL
    // uint64_t resultAddr = 0x1122334400000000UL; // Placeholder address
    uint64_t resultAddr = 0x7000000UL; // Placeholder address
    ResultBuffer resultBuf = ResultBuffer(resultAddr);
    // resultBuf.resNonces[0] = 0xBEAD;
    // atomicAdd(resultBuf.totalFound, thread);
    // atomicAdd(resultBuf.resNonces[1], thread);
#ifdef IS_MINER_RES
    atomicAdd(resultBuf.totalThreads, 1); 
#endif
    #else
    // atomicAdd(totalFound, 1);
    atomicAdd(totalFound, thread);
#endif

if (high32 < Target.y || (high32 == Target.y && low32 <= Target.x))
{
    #ifdef IS_MINER_CALL
    uint count = atomicAdd(resultBuf.totalFound, 1);
#else
    uint count = atomicAdd(totalFound, 1);
#endif
// Only the first two are saved to resNonces
if (count < 2u)
{
    uint idx = count;
    #ifdef IS_MINER_CALL
    resultBuf.resNonces[idx] = nonce;
#else
    resNonces[idx] = nonce;
#endif
}
}
}
